{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ullmer/pill",
	"title": "Pill",
	"category": "design",
	"icon": "tag",
	"parent": [ "ullmer/pill-row" ],
	"description": "Eine einzelne Pill mit Titel, optionaler Beschreibung, optionalem Link und optionalen eigenen Farben.",
	"textdomain": "ullmer-pill-row",
	"supports": {
		"html": false,
		"reusable": false,
		"customClassName": true
	},
	"attributes": {
		"title": { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "" },
		"linkTarget": { "type": "string", "default": "" },
		"rel": { "type": "string", "default": "" },

		"borderColor": { "type": "string", "default": "" },
		"backgroundColor": { "type": "string", "default": "" },
		"titleColor": { "type": "string", "default": "" },
		"descColor": { "type": "string", "default": "" },
		"hoverBorderColor": { "type": "string", "default": "" },
		"hoverBackgroundColor": { "type": "string", "default": "" },
		"hoverTitleColor": { "type": "string", "default": "" },
		"hoverDescColor": { "type": "string", "default": "" }
	},
	"editorScript": "ullmer-pill-editor",
	"style": "ullmer-pill-row-style",
	"editorStyle": "ullmer-pill-row-editor-style",
	"render": "file:./render.php"
}
